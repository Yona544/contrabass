{
  "name": "contrabass-workspace",
  "description": "A project-level orchestrator for AI coding agents",
  "private": true,
  "packageManager": "bun@1.3.4",
  "scripts": {
    "gitnexus": "node scripts/gitnexus.mjs",
    "gitnexus:analyze": "node scripts/gitnexus.mjs analyze",
    "gitnexus:analyze:embeddings": "node scripts/gitnexus.mjs analyze --embeddings",
    "gitnexus:detect": "node scripts/gitnexus.mjs detect-changes",
    "gitnexus:doctor": "node scripts/gitnexus.mjs doctor",
    "gitnexus:status": "node scripts/gitnexus.mjs status",
    "test:local": "node scripts/local-verify.mjs",
    "test:local-go": "node scripts/local-verify.mjs --go-only",
    "test:local-verify": "node --test scripts/local-verify.test.mjs",
    "test:gitnexus": "node scripts/gitnexus-smoke.mjs"
  },
  "workspaces": [
    "packages/*"
  ]
}
